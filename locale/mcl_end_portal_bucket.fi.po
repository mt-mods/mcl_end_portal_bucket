#: init.lua:18
msgid "Bucket of End Portal"
msgstr "Ämpäri End-portaalilla"

#: init.lua:19
msgid "This bucket contains end portal which can be placed."
msgstr "Tämä ämpäri sisältää End-portaalin, joka voidaan asettaa."

#: init.lua:20
msgid "Place it to empty the bucket and place an end portal."
msgstr "Aseta se tyhjentääksesi ämpärin ja asettaaksesi End-portaalin."

#: init.lua:21
msgid "Used to place end portal."
msgstr "Käytetään End-portaalin asettamiseen."
